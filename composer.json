{
    "name": "makallio85/rocksoftware-cakephp-db-sanitizer",
    "description": "CakePHP 5 plugin that masks a copy of a production database: per-column rules with deterministic fake data, a coverage check, outbound switches, and a marker that import scripts require.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "database", "anonymization", "masking", "gdpr"],
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2",
        "cakephp/migrations": "^4.0 || ^5.0",
        "fakerphp/faker": "^1.23"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "RockSoftware\\DbSanitizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockSoftware\\DbSanitizer\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --colors -p src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}
